`include "macros.v"

// 32-word instruction memory + PC.
// Instruction layout (17 bits, MSB..LSB):
//   [16:15] op       (2 bits)
//   [14:10] waddr    (5 bits)
//   [ 9: 5] raddr1   (5 bits)
//   [ 4: 0] raddr2   (5 bits)
//
// `stall` (from the controller) freezes both PC and the output.
module inst_fetch #(
    parameter DEPTH = 32,
    parameter A_LEN = 5
) (
    input              clk,
    input              rstN,
    input              stall,
    output [2:0]       op,
    output [A_LEN-1:0] waddr,
    output [A_LEN-1:0] raddr1,
    output [A_LEN-1:0] raddr2
);
    reg [17:0]      mem [DEPTH-1:0];
    reg [A_LEN-1:0] pc;

    assign {op, waddr, raddr1, raddr2} = mem[pc];

    always @(posedge clk or negedge rstN) begin
        if (!rstN)        pc <= 0;
        else if (!stall)  pc <= pc + 1'b1;
    end
endmodule

`include "macros.v"

// 32-word instruction memory + PC.
// Instruction layout (17 bits, MSB..LSB):
//   [16:15] op       (2 bits)
//   [14:10] waddr    (5 bits)
//   [ 9: 5] raddr1   (5 bits)
//   [ 4: 0] raddr2   (5 bits)
//
// `stall` (from the controller) freezes both PC and the output.
module inst_fetch #(
    parameter DEPTH = 32,
    parameter A_LEN = 5
) (
    input              clk,
    input              rstN,
    input              stall,
    output [2:0]       op,
    output [A_LEN-1:0] waddr,
    output [A_LEN-1:0] raddr1,
    output [A_LEN-1:0] raddr2
);
    reg [17:0]      mem [DEPTH-1:0];
    reg [A_LEN-1:0] pc;

    assign {op, waddr, raddr1, raddr2} = mem[pc];

    always @(posedge clk or negedge rstN) begin
        if (!rstN)        pc <= 0;
        else if (!stall)  pc <= pc + 1'b1;
    end
endmodule